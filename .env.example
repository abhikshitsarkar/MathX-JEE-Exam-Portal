# =====================================================================
# JEE Exam Portal on Neon — configuration reference (placeholders only).
# Never commit real values.
# =====================================================================

# ---- PUBLIC (bundled into the website; copy to web/.env.local) -------
# Neon Console → your project → branch "main":
#   Auth → "Auth URL"          and   Data API → "API URL"
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.ap-southeast-1.aws.neon.tech/neondb/rest/v1
# URL of the deployed `api` Neon Function (npx neonctl functions get api)
VITE_API_URL=https://br-xxxx-api.compute.c-1.ap-southeast-1.aws.neon.tech
# Optional display name
VITE_APP_NAME=MathX Test Series

# ---- SERVER-SIDE (environment of the `api` Neon Function — NEVER in web/.env*) ----
# Set at deploy time:  npx neonctl functions deploy api ... --env KEY=VALUE
# API key for the AI provider chosen in Admin → Settings (Anthropic or an
# OpenAI-compatible service). Not needed while the provider is "mock".
AI_API_KEY=REPLACE_ME
# Comma-separated sites allowed to call the function
ALLOWED_ORIGINS=https://YOUR-FIREBASE-PROJECT-ID.web.app,http://localhost:5173
# Optional: actual bucket names if you did not name them documents / question-images
# BUCKET_DOCUMENTS=documents
# BUCKET_QUESTION_IMAGES=question-images
#
# Neon injects these automatically when the services are enabled on the branch —
# do not set them yourself: DATABASE_URL, NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL,
# NEON_DATA_API_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION
